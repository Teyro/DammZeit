<?xml version="1.0" encoding="utf-8"?>
<!-- Startknopf: alle Ringe exakt konzentrisch (gleiche Abstände ringsum) – sonst werden Kreise zu Ellipsen
     und Farbe und Rand sitzen versetzt. Außen ein feiner Schattenring, dann Weiß, innen die Farbe. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="oval"><solid android:color="#26000000" /></shape></item>
    <item android:bottom="1.5dp" android:left="1.5dp" android:right="1.5dp" android:top="1.5dp"><shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape></item>
    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp"><shape android:shape="oval"><gradient android:angle="270" android:startColor="#FF2A7E96" android:endColor="#FF02546B" /></shape></item>
</layer-list>
