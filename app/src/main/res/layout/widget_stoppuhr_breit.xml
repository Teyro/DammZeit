<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/stoppuhr_karte"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/stopp_kopf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_w_stoppuhr" />

            <TextView
                android:id="@+id/stopp_titel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="Stoppuhr"
                android:textColor="#FF5B5F66"
                android:textSize="13sp" />
        </LinearLayout>

        <Chronometer
            android:id="@+id/stopp_zeit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:textColor="#FF1F2124"
            android:textSize="36sp" />

        <TextView
            android:id="@+id/stopp_runden"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#FF5B5F66"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/stopp_startstopp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_knopf_start"
                android:contentDescription="Start oder Stopp"
                android:padding="13dp"
                android:src="@drawable/ic_w_start" />

            <ImageView
                android:id="@+id/stopp_runde"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_knopf_hell"
                android:contentDescription="Runde"
                android:padding="12dp"
                android:src="@drawable/ic_w_runde" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/stopp_zurueck"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/widget_knopf_hell"
                android:contentDescription="Zurücksetzen"
                android:padding="12dp"
                android:src="@drawable/ic_w_zurueck" />

            <ImageView
                android:id="@+id/stopp_speichern"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_knopf_hell"
                android:contentDescription="Zeit speichern"
                android:padding="12dp"
                android:src="@drawable/ic_w_speichern" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
